{
  "name": "mcp-builder",
  "version": "0.1.0",
  "description": "Mapeia uma empresa (do negócio à infraestrutura) e gera a base de um servidor MCP para agentes de IA.",
  "type": "module",
  "bin": {
    "mcp-builder": "dist/cli.js"
  },
  "scripts": {
    "start": "npm run build --silent && node dist/cli.js",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "docs": "tsx scripts/gerar-docs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^12.1.0",
    "mssql": "12.7.11",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
